# monday.com read-only personal API token.
# Generate at: monday.com > Administration > API (or Developers > My Access Tokens)
# Copy this file to .env.local and paste your real token — DO NOT commit .env.local.
MONDAY_API_TOKEN=paste-your-read-only-token-here

# Board IDs are hardcoded in lib/types.ts (DEALS_BOARD_ID / WORK_ORDERS_BOARD_ID);
# override here only if you point the app at a different workspace copy.
# DEALS_BOARD_ID=5030843288
# WORK_ORDERS_BOARD_ID=5030843478

# OpenAI API key for the Phase 2 conversational agent (function calling).
OPENAI_API_KEY=paste-your-openai-key-here
# Model override (default: gpt-4o). gpt-4o-mini is cheaper/faster.
# OPENAI_MODEL=gpt-4o
